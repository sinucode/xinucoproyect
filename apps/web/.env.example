# ══════════════════════════════════════════════════════════════════════════════
# apps/web — Variables de Entorno (Plataforma / Admin Global)
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees .env.local al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase CONTROL (auth + registro global de negocios) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NOTA Fase 1: Comparte la misma base que apps/barberia hasta el split (Fase 4).
# En Fase 4, aquí irá el proyecto Supabase de CONTROL (auth + registro maestro).

# ── Fan-out de verticales (Fase 4+) ──────────────────────────────────────────
# Credenciales por vertical para que /admin pueda agregar métricas globales.
# Solo accedidas desde Server Components/Actions (NO marcar NEXT_PUBLIC_).
# SUPABASE_URL_BARBERIA=
# SUPABASE_SERVICE_ROLE_KEY_BARBERIA=
# SUPABASE_URL_CREDITOS=
# SUPABASE_SERVICE_ROLE_KEY_CREDITOS=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Zonas (login único del super_admin en apps/web) ──────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_BARBERIA_URL=http://localhost:3001

# ── hCaptcha ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
