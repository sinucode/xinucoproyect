# ══════════════════════════════════════════════════════════════════════════════
# apps/barberia — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA commitees .env.local al repositorio.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase BARBERÍA (base de datos de la vertical) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NOTA Fase 1: Comparte la misma base que apps/web hasta el split de Supabase (Fase 4).
# En Fase 4, aquí irá el proyecto Supabase exclusivo de la vertical Barbería.

# ── Multi-Zone: URL de la zona web (apps/web) para los rewrites ──────────────
# En desarrollo: http://localhost:3000
# En producción: URL del deployment de apps/web en Vercel (ej: https://web.xinuco.com)
WEB_ZONE_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Zonas (login único del super_admin en apps/web) ──────────────────────────
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_BARBERIA_URL=http://localhost:3001

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Resend (recordatorios de citas por email) ─────────────────────────────────
RESEND_API_KEY=re_...

# ── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── hCaptcha ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# ── MercadoPago ───────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-...
MP_APP_ID=
MP_WEBHOOK_SECRET=
